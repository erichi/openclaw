# Gmail monitor configuration
# Copy to ~/.openclaw/gmail-monitor.env and fill in your values

# Your Gmail address (gog must be authenticated for this account)
GOG_ACCOUNT=you@gmail.com

# Telegram target to receive reports
# Use your Telegram username (@yourname), chat ID, or phone number
OPENCLAW_TELEGRAM_TARGET=@yourname

# Max emails to process per rule (default: 200)
MAX_PER_QUERY=200

# Set to 1 to preview without archiving anything
DRY_RUN=0

# Set to 0 to always send a report, even when inbox is clean (default: 1 = only report when emails were found)
REPORT_ONLY_IF_FOUND=1
